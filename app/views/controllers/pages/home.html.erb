  <div role="alert" class="alert alert-success">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6 shrink-0 stroke-current"
      fill="none"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
      />
    </svg>
    <span>The frontend is running on Vite with Tailwind &amp; daisyUI.</span>
  </div>

  <h1 class="mt-8 text-3xl font-bold">Rails Starter</h1>
  <p class="mt-2">A themed daisyUI button:</p>
  <button type="button" class="btn btn-primary mt-4">Primary button</button>

  <hr class="my-8">

  <button
    type="button"
    class="btn"
    data-controller="modal-open"
    data-modal-open-id-value="starter-modal"
    data-action="click->modal-open#open"
  >Open</button>

  <%= component "modal", id: "starter-modal", title: "Starter modal" do %>
    <p class="py-4">Opened with <code>dialog.showModal()</code> via the external <code>modal-open</code> Stimulus controller; the modal itself only owns dismissal.</p>
  <% end %>

  <hr class="mt-8">

  <%= component "banner", title: "Rails Starter" %>
