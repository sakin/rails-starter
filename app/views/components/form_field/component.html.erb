<% if content.present? || label.present? || error_message.present? %>
  <div class="<%= class_for("root") %>">
    <% if label.present? %>
      <label class="<%= class_for("label") %>"><%= label %></label>
    <% end %>
    <div class="<%= class_for("control") %>"><%= content %></div>
    <% if error_message.present? %>
      <p class="<%= class_for("error") %>"><%= error_message %></p>
    <% end %>
  </div>
<% end %>
