# frozen_string_literal: true
<% merged = wrapper_options.deep_merge(data: { controller: controller_name }) %>
<%= content_tag :div, **merged do %>
  <button type="button" class="btn" data-action="click->modal#open"><%= trigger_label %></button>
  <dialog id="<%= id %>" class="modal" data-modal-target="dialog" data-action="click.self->modal#close">
    <div class="modal-box">
      <h3 class="text-lg font-bold"><%= title %></h3>
      <%= content %>
      <div class="modal-action">
        <button type="button" class="btn" data-action="click->modal#close"><%= close_label %></button>
      </div>
    </div>
  </dialog>
<% end %>
